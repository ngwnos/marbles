{
  "name": "marble",
  "private": true,
  "version": "0.0.0",
  "description": "A procedural marble-run builder with Three.js WebGPU rendering and Box3D physics.",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite",
    "build": "tsc --noEmit && bun --bun vite build",
    "deploy": "wrangler deploy",
    "preview": "bun --bun vite preview --host 127.0.0.1 --port 5215 --strictPort",
    "check:files": "bun scripts/check-repo-files.ts",
    "check:history": "bun scripts/check-repo-files.ts --history",
    "test:smoke": "bun run test:surfaces && bun run test:receiver-floors && bun run test:assembly && bun run test:instance-buffer && bun run test:construction && bun run test:marble-follow && bun run test:maze-orbit && bun run test:gate-fill",
    "test:instance-buffer": "bun scripts/test-instance-buffer.ts && bun scripts/test-pose-updates.ts",
    "benchmark:assembly": "bun scripts/benchmark-assembly.ts",
    "geometry:paddle": "bun scripts/build-paddle.ts",
    "geometry:intersection": "bun scripts/build-intersection.ts",
    "geometry:snake": "bun scripts/build-snake.ts",
    "geometry:receivers": "bun scripts/build-receivers.ts",
    "test:receiver-floors": "bun scripts/check-receiver-floors.ts",
    "test:downspout-load": "bun scripts/test-downspout-load.ts",
    "test:alignment": "bun scripts/check-component-alignment.ts",
    "test:components": "bun scripts/check-components.ts",
    "test:component-normals": "bun scripts/refresh-component-normals.ts --check",
    "test:finish-surface": "bun scripts/check-finish-surface.ts",
    "geometry:normals": "bun scripts/refresh-component-normals.ts",
    "test:surfaces": "bun tests/surfaces.ts",
    "physics:build": "bash tools/box3d/build.sh",
    "physics:colliders": "bun scripts/build-wheel-collider.ts && bun scripts/build-preview-colliders.ts",
    "physics:check": "bun scripts/test-preview-drops.ts",
    "physics:base": "bun scripts/test-base-drops.ts",
    "geometry:base": "bun scripts/build-base.ts",
    "geometry:bumper": "bun scripts/build-bumper.ts",
    "geometry:maze": "bun scripts/build-maze.ts",
    "geometry:landing": "bun scripts/build-landing.ts",
    "physics:landing": "bun scripts/test-landing-drops.ts",
    "geometry:jump": "bun scripts/build-jump.ts && bun scripts/build-jump-assembly.ts",
    "physics:jump": "bun scripts/test-jump-drops.ts && bun scripts/test-jump-transfer.ts",
    "geometry:split": "bun scripts/build-split.ts",
    "physics:split": "bun scripts/test-split-drops.ts",
    "geometry:finish": "bun scripts/build-finish.ts",
    "physics:finish": "bun scripts/test-finish-drops.ts",
    "geometry:passing": "bun scripts/build-passing.ts",
    "physics:passing": "bun scripts/test-passing-drops.ts",
    "geometry:hairpin": "bun scripts/build-hairpin.ts",
    "physics:hairpin": "bun scripts/test-hairpin-drops.ts",
    "geometry:start": "bun scripts/build-start.ts",
    "physics:start": "bun scripts/test-start-drops.ts",
    "geometry:extension": "bun scripts/build-extension.ts",
    "physics:extension": "bun scripts/test-extension.ts",
    "geometry:coupler": "bun scripts/build-coupler.ts",
    "physics:coupler": "bun scripts/test-coupler.ts",
    "geometry:starter-funnel": "bun scripts/build-starter-funnel.ts",
    "physics:starter-funnel": "bun scripts/test-starter-funnel.ts",
    "geometry:coil": "bun scripts/build-coil.ts",
    "physics:coil": "bun scripts/test-coil-drops.ts",
    "test:stacked-entrances": "bun scripts/test-stacked-entrances.ts",
    "test:contact-model": "bun scripts/test-contact-model.ts && bun scripts/test-funnel-bridge.ts",
    "test:receiver-clearance": "bun scripts/check-receiver-clearance.ts",
    "test:start-jams": "bun scripts/test-start-jams.ts",
    "test:marble-follow": "bun scripts/test-marble-follow.ts",
    "test:maze-orbit": "bun scripts/test-maze-orbit.ts",
    "test:construction-camera": "bun scripts/test-construction-camera.ts",
    "test:gate-fill": "bun scripts/test-gate-fill.ts",
    "test:presets": "bun scripts/test-presets.ts",
    "test:preset-clearance": "bun scripts/check-preset-clearance.ts",
    "test:preset-packs": "bun scripts/test-preset-packs.ts",
    "test:assembly": "bun scripts/test-assembly.ts",
    "geometry:assembly": "bun scripts/build-assembly-assets.ts && bun scripts/build-piece-envelopes.ts",
    "test:physics-feel": "bun scripts/test-physics-feel.ts",
    "geometry:storage-tub": "bun scripts/build-storage-tub.ts && bun scripts/build-tub-envelopes.ts",
    "test:storage-tub": "bun scripts/test-storage-tub.ts",
    "geometry:piece-envelopes": "bun scripts/build-piece-envelopes.ts",
    "test:tub-packing": "bun scripts/test-tub-packing.ts",
    "geometry:tub-envelopes": "bun scripts/build-tub-envelopes.ts",
    "test:tub-tipping": "bun scripts/test-tub-tipping.ts",
    "geometry:tub-fills": "bun scripts/build-tub-fills.ts",
    "test:tub-fills": "bun scripts/test-baked-tub-fills.ts",
    "test:tub-dump": "bun scripts/test-tub-dump.ts",
    "test:construction": "bun scripts/test-construction.ts"
  },
  "dependencies": {
    "box3d-wasm": "^0.2.0",
    "manifold-3d": "3.5.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "wrangler": "4.131.1"
  }
}
