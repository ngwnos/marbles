+// Owns mesh data; keep alive until every referencing world is destroyed.
+struct MeshGeometry {
+ b3MeshData* data;
+ MeshGeometry(val opts) {
+  val vp=opts["vertices"], ip=opts["indices"];
+  std::vector<b3Vec3> vertices;
+  for(int i=0;i<vp["length"].as<int>();i+=3)
+   vertices.push_back({vp[i].as<float>(),vp[i+1].as<float>(),vp[i+2].as<float>()});
+  std::vector<int32_t> indices;
+  for(int i=0;i<ip["length"].as<int>();i++) indices.push_back(ip[i].as<int>());
+  b3MeshDef def={}; def.vertices=vertices.data(); def.indices=indices.data();
+  def.vertexCount=vertices.size(); def.triangleCount=indices.size()/3;
+  def.weldVertices=true; def.weldTolerance=0.00001f; def.identifyEdges=true;
+  data=b3CreateMesh(&def,nullptr,0);
+ }
+ ~MeshGeometry(){if(data)b3DestroyMesh(data);}
+};
